# ── SissyTrends .gitignore ──────────────────────────────────────

# Environment variables / secrets — NEVER commit
.env
.env.local
.env.*.local

# Local dev marker — tells api.py to use local DB, not Render disk
.localdev

# SQLite DB — excluded from git (regenerated from init_db.py + CSV on first run)
data/sissytrends.db
data/sissytrends.db-shm
data/sissytrends.db-wal
sissytrends.db
sissytrends.db-shm
sissytrends.db-wal

# DB backups — local only, never commit
data/backups/
*.bak

# Python
__pycache__/
*.pyc
*.pyo

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
*.log

# One-off patch scripts
patch_mainjs.py
patch_admin_login.py
_remove_otp_set_live.py
_test_env.py

# Admin env config with credentials
admin/env-config.js
